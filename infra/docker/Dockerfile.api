FROM python:3.12-slim
WORKDIR /app

COPY packages packages
COPY apps/api-server apps/api-server
COPY requirements.txt requirements.txt

RUN pip install --no-cache-dir \
      -e packages/shared \
      -e packages/pdf_engine \
      -e packages/accounting_engine \
      -e packages/accounting_data \
      -e packages/ml_pipeline \
      -e packages/dart_integration \
      -e apps/api-server

COPY docs docs
COPY infra infra

EXPOSE 8081
CMD ["python", "apps/api-server/wsgi.py"]
