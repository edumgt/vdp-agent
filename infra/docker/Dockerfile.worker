FROM python:3.12-slim
WORKDIR /app

COPY packages packages
COPY apps/worker apps/worker

RUN pip install --no-cache-dir \
      -e packages/shared \
      -e packages/pdf_engine \
      -e packages/accounting_engine \
      -e packages/accounting_data \
      -e packages/ml_pipeline \
      -e packages/dart_integration \
      -e apps/worker

# EasyOCR(실제 DL 모델)을 쓰려면 빌드 시 --build-arg WITH_OCR=1
ARG WITH_OCR=0
COPY requirements-ocr.txt requirements-ocr.txt
RUN if [ "$WITH_OCR" = "1" ]; then pip install --no-cache-dir -r requirements-ocr.txt; fi

COPY docs docs
COPY infra infra

CMD ["python", "apps/worker/run_worker.py"]
