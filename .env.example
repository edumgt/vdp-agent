# ====== SERVER ======
FLASK_ENV=development
API_PORT=8081

# ====== DB (Postgres) ======
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=joya
POSTGRES_USER=joya
POSTGRES_PASSWORD=joya1234

# ====== Redis / RQ ======
REDIS_HOST=localhost
REDIS_PORT=6379

# ====== Storage ======
STORAGE_MODE=local  # local | minio
LOCAL_PDF_DIR=./storage/pdfs
LOCAL_UPLOAD_DIR=./storage/uploads

# MinIO (optional)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=joya-pdfs

# ====== Fonts ======
# 임베딩 허용 폰트만 사용하세요(라이선스 확인 필수). 레포에는 폰트 바이너리를 포함하지 않습니다.
FONTS_DIR=./assets/fonts

# ====== Worker (RQ) ======
WORKER_CONCURRENCY=2

# ====== ML Pipeline ======
# fixture(오프라인/결정적, 기본값) | easyocr(실제 PyTorch DL 모델, requirements-ocr.txt 필요)
OCR_PROVIDER=fixture

# ====== OpenDART(전자공시시스템) ======
# 미설정 시 packages/dart_integration/fixtures의 공개 샘플 데이터로 자동 대체됩니다.
# 발급: https://opendart.fss.or.kr (회원가입 후 인증키 발급, 40자리)
DART_API_KEY=
DART_CACHE_DIR=./.cache/dart
